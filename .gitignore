# environment
.env
.env.*
!.env.example

# dependencies
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
!/web/dist/
build/
.eggs/

#Lavish
.lavish/*

# uv
.python-version

# data (local only) — anything generated from or about the owner's vault
~/.ytk/
*.db
ytk/ui/static/map.json
chroma/
.chroma/
covers/
frames/
screenshots/
*.log

# credentials and session artifacts (never stage, wherever they land)
*.session
*_session.json
*_state.json
client_secret*.json
token.json
*credentials*.json

# claude code session state
.claude/
.superpowers/
ytk/CLAUDE.md

# git worktrees
.worktrees/

# macOS
.DS_Store
docs/session-*-brief.md
experiments/encoder_harness/data/
# E2 SAE run outputs: ~500MB of checkpoints and cached vectors, all
# regenerable from experiments/sae_qwen/*.py at fixed seeds. No trailing
# slash: these are per-worktree symlinks into ~/.ytk/sae, not directories,
# and a trailing slash would leave the links tracked.
experiments/sae_qwen/checkpoints
experiments/sae_qwen/data
media/

# E1 embedding cache, regenerable by scripts/e1_style_lens.py
docs/assets/23-style-lens/style-chunks.npz
