ANTHROPIC_API_KEY=sk-ant-...
OBSIDIAN_VAULT_PATH=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault
CHROMA_PATH=~/.ytk/chroma
CHROMA_URL=http://127.0.0.1:8000
CHROMA_SERVER_PATH=~/.ytk/chroma-server
# 'sessionid' cookie from an instagram.com browser session — used by `ytk reels`
INSTAGRAM_SESSIONID=
# username of the account on the other side of the capture thread (two-account
# pattern); leave empty to use the note-to-self thread of the logged-in account
INSTAGRAM_PEER=
